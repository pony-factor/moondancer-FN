{
  "name": "moondancer-fn",
  "displayName": "Moondancer FN",
  "publisher": "pony-factor",
  "description": "Support Markdown footnotes in VS Code",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.57.0"
  },
  "author": "Mai Hou <houkanshan@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/pony-factor/moondancer-FN.git"
  },
  "bugs": {
    "url": "https://github.com/pony-factor/moondancer-FN/issues"
  },
  "icon": "assets/moondancer-icon.png",
  "keywords": [
    "moondancer",
    "markdown",
    "footnote",
    "footnotes",
    "preview",
    "notes",
    "note taking"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:vscode-markdown-footnote.openFootnoteEditor",
    "onCommand:vscode-markdown-footnote.spellcheckSelection",
    "onCommand:vscode-markdown-footnote.quickInsertFootnote"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-markdown-footnote.insertFootnote",
        "title": "Insert a Footnote"
      },
      {
        "command": "vscode-markdown-footnote.openFootnoteEditor",
        "title": "Open Footnote Editor"
      },
      {
        "command": "vscode-markdown-footnote.spellcheckSelection",
        "title": "Spellcheck Selection with Spellcheck Only"
      },
      {
        "command": "vscode-markdown-footnote.quickInsertFootnote",
        "title": "Quick Insert Footnote"
      }
    ],
    "markdown.markdownItPlugins": true,
    "configuration": {
      "title": "Moondancer FN",
      "properties": {
        "vscode-markdown-footnote.separateFootnoteFile": {
          "type": "boolean",
          "default": false,
          "description": "Store footnote definitions in a separate Markdown file beside the source document instead of in the source document itself."
        },
        "vscode-markdown-footnote.footnoteFileName": {
          "type": "string",
          "default": "footnotes.md",
          "description": "File name used for footnote definitions when separate footnote storage is enabled."
        },
        "vscode-markdown-footnote.spellcheckPluginName": {
          "type": "string",
          "default": "Spellcheck Only",
          "description": "Installed ChatGPT plugin name used by the Markdown spellcheck code action."
        }
      }
    },
    "keybindings": [
      {
        "command": "vscode-markdown-footnote.quickInsertFootnote",
        "key": "ctrl+shift+6",
        "mac": "cmd+shift+6",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ]
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ]
  },
  "scripts": {
    "lint": "eslint src --ext ts",
    "check-types": "tsc --noEmit -p ./",
    "test": "jest",
    "test:watch": "jest --watch",
    "publish": "npx vsce publish",
    "watch": "tsc -watch -p ./",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^12.1.4",
    "@commitlint/config-conventional": "^12.1.4",
    "@types/glob": "^7.1.3",
    "@types/jest": "^26.0.23",
    "@types/node": "^15.12.4",
    "@types/vscode": "^1.57.0",
    "@typescript-eslint/eslint-plugin": "^4.28.0",
    "@typescript-eslint/parser": "^4.28.0",
    "commitlint": "^12.1.4",
    "eslint": "^7.29.0",
    "glob": "^7.1.7",
    "husky": "^6.0.0",
    "jest": "^27.0.5",
    "lint-staged": "^11.0.0",
    "prettier": "^2.3.1",
    "ts-jest": "^27.0.3",
    "typescript": "^4.3.4",
    "vsce": "^1.94.0",
    "vscode-test": "^1.5.2"
  },
  "dependencies": {
    "markdown-it-footnote": "^3.0.3"
  },
  "homepage": "https://github.com/pony-factor/moondancer-FN#readme",
  "contributors": [
    "John Wooten <john.wooten@blocktransfer.com>"
  ]
}
